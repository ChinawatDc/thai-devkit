{
  "name": "@chinawatdc/thai-address-suggest",
  "version": "1.0.1",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "echo \"No test yet\""
  },
  "keywords": [
    "thai",
    "address",
    "autocomplete",
    "thailand",
    "province",
    "district",
    "subdistrict"
  ],
  "author": "",
  "license": "ISC",
  "description": "API เล็กๆ ในตัวเพื่อใช้ทำ Auto-complete ในฟอร์มต่างๆ แบบเบาๆ (ไม่ต้องโหลด DB ใหญ่ๆ)",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  }
}
