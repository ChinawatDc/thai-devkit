{
  "name": "@chinawatdc/tiny-fetch-wrapper",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "test": "echo \"No test yet\""
  },
  "keywords": [
    "fetch",
    "wrapper",
    "retry",
    "http",
    "request",
    "axios-alternative",
    "tiny",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "description": "ตัวครอบ fetch API ให้ใช้ง่ายขึ้น มีระบบ Retry เมื่อพัง จัดการ Error สไตล์ axios แต่เบากว่า 10 เท่า",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  }
}