{
  "name": "@chinawatdc/env-type-checker",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "keywords": [
    "env",
    "environment",
    "validation",
    "type-checker",
    "dotenv",
    "schema",
    "config"
  ],
  "author": "",
  "license": "ISC",
  "description": "สคริปต์เช็กว่าไฟล์ .env มีตัวแปรครบถ้วนและชนิดข้อมูลถูกต้องก่อนที่จะรันเซิร์ฟเวอร์",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  }
}